# =============================================================================
# AI-Based Real-Time Threat Detection Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# Usage:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#   Then edit .env with your values.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=threat_detection
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=dev_password_change_in_production

# Constructed DATABASE_URL (used by backend)
DATABASE_URL=postgresql+asyncpg://threat_user:dev_password_change_in_production@postgres:5432/threat_detection

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=INFO
BACKEND_RELOAD=true

# JWT Configuration
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# CORS (allowed origins, comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Detection Service
# -----------------------------------------------------------------------------
DETECTION_MODEL_PATH=/app/models/weapon_detector.pt
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_NMS_IOU_THRESHOLD=0.45
DETECTION_INPUT_SIZE=640
DETECTION_DEVICE=auto

# Multi-frame Verification
VERIFICATION_N=3
VERIFICATION_M=5

# Threat Scoring Weights
SCORING_WEIGHT_WEAPON_TYPE=0.3
SCORING_WEIGHT_CONFIDENCE=0.25
SCORING_WEIGHT_PROXIMITY=0.2
SCORING_WEIGHT_DURATION=0.15
SCORING_WEIGHT_COUNT=0.1
SCORING_INCIDENT_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# Evidence Storage
# -----------------------------------------------------------------------------
EVIDENCE_STORAGE_PATH=/app/evidence
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_CLIP_PRE_SECONDS=10
EVIDENCE_CLIP_POST_SECONDS=10
EVIDENCE_SNAPSHOT_QUALITY=95

# -----------------------------------------------------------------------------
# Privacy-Preserving Processing (optional face anonymization)
# -----------------------------------------------------------------------------
# Mode: off | face_blur | face_pixelate
# Applied to evidence snapshots BEFORE they are written to storage — there
# is never an unblurred copy retained once a non-"off" mode is active.
# This is face LOCALIZATION only (Haar cascade) — no facial recognition,
# embeddings, or identity inference of any kind is performed anywhere in
# this platform. See backend/app/privacy/config.py for full documentation
# of scope and known limitations.
PRIVACY_MODE=off
PRIVACY_BLUR_KERNEL_RATIO=0.35
PRIVACY_PIXELATE_BLOCK_SIZE=12
PRIVACY_DETECTION_SCALE_FACTOR=1.1
PRIVACY_DETECTION_MIN_NEIGHBORS=5
PRIVACY_DETECTION_MIN_FACE_RATIO=0.02
PRIVACY_EXPAND_BOX_RATIO=0.15

# -----------------------------------------------------------------------------
# Admin Seed (first-time setup)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@threatplatform.local
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Administrator
